<configuration scan="true" scanPeriod="60 seconds">

    <property name="LOG_HOME" value="Axis-Bank-Logs"/>

    <!-- File Appender -->
    <appender name="AppFile"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

    <!-- Console Appender -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} {[traceId=%X{traceId}]} [%level] [%thread] %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_HOME}/archive/axisbank-app-%d{yyyy-MM-dd}.log.gz
            </fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS}
                {[traceId=%X{traceId}]}
                [%level] [%thread] %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- Async Wrapper -->
    <appender name="AsyncApp"
              class="ch.qos.logback.classic.AsyncAppender">

        <queueSize>10000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>

        <appender-ref ref="AppFile"/>

    </appender>

    <root level="INFO">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncApp"/>
    </root>

    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>

</configuration>